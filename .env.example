# Modèle de configuration : copie ce fichier en `.env` et remplis les valeurs.
# `.env` est ignoré par git ; `.env.example` est versionné et ne contient aucun secret.

# OpenRouteService (routage principal)
ORS_API_KEY=

# API (facultatif ; valeurs par défaut entre parenthèses)
# PORT=8787
# ALLOWED_ORIGINS=https://trajet.tondomaine.fr,http://localhost:3000   (CORS ; vide = désactivé)
# TOLL_BOOK_PATH, OSM_BOOTHS_PATH, VEHICLES_PATH, FUEL_PRICES_PATH     (fichiers de données, voir docs/07-api.md)

# Base de données Supabase (voir docs/08-supabase.md)
# Chaîne de connexion « Session pooler » (IPv4). Secret : ne jamais la partager ni la committer.
# Si définie, l'API lit les données de référence en base ; sinon elle lit les fichiers locaux.
# DATABASE_URL=
# DATABASE_CA_PATH=   (facultatif : certificat racine Supabase pour une vérification TLS stricte)

# Prévus plus tard (laisser vides pour l'instant)
# GRAPHHOPPER_API_KEY=
# GEOAPIFY_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
